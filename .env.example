# Copia este archivo como .env y ajusta los valores a tu entorno local

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DB_NAME=roboneuro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Autenticación
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# CORS - URL de tu frontend (Vite)
FRONTEND_URL=http://localhost:5173

# Credenciales del primer usuario admin (se crea automáticamente si no existe ninguno)
ADMIN_EMAIL=admin@neuroed.com
ADMIN_PASSWORD=123456
